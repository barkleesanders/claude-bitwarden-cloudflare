diff --git a/src/crypto.rs b/src/crypto.rs
index 8882e51..14d2ffa 100644
--- a/src/crypto.rs
+++ b/src/crypto.rs
@@ -331,3 +331,70 @@ pub fn generate_api_key() -> Result<String, AppError> {
 pub fn ct_eq(a: &str, b: &str) -> bool {
     constant_time_eq(a.as_bytes(), b.as_bytes())
 }
+
+/// PKCE S256 transform: base64url-nopad(SHA-256(code_verifier)).
+pub fn pkce_s256(verifier: &str) -> String {
+    use base64::engine::general_purpose::URL_SAFE_NO_PAD;
+    use base64::Engine;
+    use sha2::Digest;
+    let mut h = Sha256::new();
+    h.update(verifier.as_bytes());
+    URL_SAFE_NO_PAD.encode(h.finalize())
+}
+
+/// Verify an RS256 signature against an RSA public key supplied as a JWK.
+/// Used for OIDC id_token verification. Returns Ok(true) only on a valid signature.
+pub async fn verify_rs256_jwk(
+    jwk: &serde_json::Value,
+    signing_input: &[u8],
+    signature: &[u8],
+) -> Result<bool, AppError> {
+    let subtle = subtle_crypto()?;
+
+    // Algorithm descriptor for RSASSA-PKCS1-v1_5 + SHA-256.
+    let algorithm = js_sys::Object::new();
+    js_sys::Reflect::set(
+        &algorithm,
+        &JsValue::from_str("name"),
+        &JsValue::from_str("RSASSA-PKCS1-v1_5"),
+    )
+    .map_err(|_| AppError::Crypto("alg name".to_string()))?;
+    js_sys::Reflect::set(
+        &algorithm,
+        &JsValue::from_str("hash"),
+        &JsValue::from_str("SHA-256"),
+    )
+    .map_err(|_| AppError::Crypto("alg hash".to_string()))?;
+
+    // The JWK as a JS object.
+    let jwk_obj = worker::d1::serde_wasm_bindgen::to_value(jwk)
+        .map_err(|e| AppError::Crypto(format!("jwk to_value: {e:?}")))?;
+    let jwk_obj: &js_sys::Object = jwk_obj.unchecked_ref();
+
+    let usages = js_sys::Array::of1(&JsValue::from_str("verify"));
+    let key = JsFuture::from(
+        subtle
+            .import_key_with_object("jwk", jwk_obj, &algorithm, false, &usages)
+            .map_err(|e| AppError::Crypto(format!("import_key: {e:?}")))?,
+    )
+    .await
+    .map_err(|e| AppError::Crypto(format!("import_key await: {e:?}")))?;
+    let crypto_key = CryptoKey::from(key);
+
+    let sig = Uint8Array::new_from_slice(signature);
+    let data = Uint8Array::new_from_slice(signing_input);
+    let verified = JsFuture::from(
+        subtle
+            .verify_with_object_and_buffer_source_and_buffer_source(
+                &algorithm,
+                &crypto_key,
+                sig.as_ref(),
+                data.as_ref(),
+            )
+            .map_err(|e| AppError::Crypto(format!("verify: {e:?}")))?,
+    )
+    .await
+    .map_err(|e| AppError::Crypto(format!("verify await: {e:?}")))?;
+
+    Ok(verified.as_bool().unwrap_or(false))
+}
