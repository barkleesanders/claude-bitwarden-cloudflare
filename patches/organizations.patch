@@ -0,0 +1,124 @@
+use axum::extract::{Path, State};
+use axum::Json;
+use serde::Deserialize;
+use serde_json::{json, Value};
+use std::sync::Arc;
+use uuid::Uuid;
+use worker::Env;
+
+use crate::auth::Claims;
+use crate::d1_query;
+use crate::db::{self, Db};
+use crate::error::AppError;
+use crate::handlers::organizations::require_org_manage;
+
+// Bitwarden EventType subset we emit.
+pub const ORG_CREATED: i64 = 1600;
+pub const MEMBER_INVITED: i64 = 1500;
+pub const MEMBER_CONFIRMED: i64 = 1501;
+pub const MEMBER_UPDATED: i64 = 1502;
+pub const MEMBER_REMOVED: i64 = 1503;
+pub const COLLECTION_CREATED: i64 = 1300;
+pub const COLLECTION_DELETED: i64 = 1302;
+pub const GROUP_CREATED: i64 = 1400;
+pub const GROUP_DELETED: i64 = 1402;
+pub const POLICY_UPDATED: i64 = 1700;
+
+/// What an event points at (only one is set).
+pub enum Target<'a> {
+    None,
+    Member(&'a str),
+    Collection(&'a str),
+    Group(&'a str),
+    // Reserved for cipher-level audit events (org admin actions are instrumented today).
+    #[allow(dead_code)]
+    Cipher(&'a str),
+}
+
+/// Append an org event. Best-effort: never fails the caller's operation.
+pub async fn log_event(
+    db: &Db,
+    org_id: &str,
+    event_type: i64,
+    acting_user_id: &str,
+    target: Target<'_>,
+) {
+    let (member, collection, group, cipher) = match target {
+        Target::None => (None, None, None, None),
+        Target::Member(id) => (Some(id), None, None, None),
+        Target::Collection(id) => (None, Some(id), None, None),
+        Target::Group(id) => (None, None, Some(id), None),
+        Target::Cipher(id) => (None, None, None, Some(id)),
+    };
+    let now = db::now_string();
+    let id = Uuid::new_v4().to_string();
+    let stmt = d1_query!(
+        db,
+        "INSERT INTO org_events (id, organization_id, event_type, acting_user_id, member_id, \
+         cipher_id, collection_id, group_id, policy_id, device_type, ip_address, created_at) \
+         VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8, NULL, NULL, NULL, ?9)",
+        id,
+        org_id,
+        event_type,
+        acting_user_id,
+        member,
+        cipher,
+        collection,
+        group,
+        now
+    );
+    if let Ok(stmt) = stmt {
+        let _ = stmt.run().await;
+    }
+}
+
+#[derive(Debug, Deserialize)]
+struct EventRow {
+    event_type: i64,
+    acting_user_id: Option<String>,
+    member_id: Option<String>,
+    cipher_id: Option<String>,
+    collection_id: Option<String>,
+    group_id: Option<String>,
+    created_at: String,
+}
+
+/// GET /api/organizations/{id}/events — recent org audit events (Owner/Admin).
+#[worker::send]
+pub async fn list_events(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Path(org_id): Path<String>,
+) -> Result<Json<Value>, AppError> {
+    let db = db::get_db(&env)?;
+    require_org_manage(&db, &claims.sub, &org_id).await?;
+
+    let rows: Vec<EventRow> = d1_query!(
+        &db,
+        "SELECT event_type, acting_user_id, member_id, cipher_id, collection_id, group_id, created_at \
+         FROM org_events WHERE organization_id = ?1 ORDER BY created_at DESC LIMIT 200",
+        org_id
+    )
+    .map_err(|_| AppError::Database)?
+    .all()
+    .await?
+    .results()
+    .map_err(|_| AppError::Database)?;
+
+    let items: Vec<Value> = rows
+        .into_iter()
+        .map(|r| {
+            json!({
+                "type": r.event_type,
+                "actingUserId": r.acting_user_id,
+                "organizationUserId": r.member_id,
+                "cipherId": r.cipher_id,
+                "collectionId": r.collection_id,
+                "groupId": r.group_id,
+                "date": r.created_at,
+                "object": "event",
+            })
+        })
+        .collect();
+    Ok(Json(json!({ "data": items, "object": "list", "continuationToken": Value::Null })))
+}
