+/// Replace a group's collection grants.
+async fn assign_group_collections(
+    db: &Db,
+    org_id: &str,
+    group_id: &str,
+    selections: &[CollectionAccessSelection],
+) -> Result<(), AppError> {
+    d1_query!(db, "DELETE FROM collection_groups WHERE group_id = ?1", group_id)
+        .map_err(|_| AppError::Database)?
+        .run()
+        .await?;
+    for sel in selections {
+        let belongs: Option<IdRow> = d1_query!(
+            db,
+            "SELECT id FROM collections WHERE id = ?1 AND organization_id = ?2",
+            sel.id,
+            org_id
+        )
+        .map_err(|_| AppError::Database)?
+        .first(None)
+        .await?;
+        if belongs.is_none() {
+            continue;
+        }
+        d1_query!(
+            db,
+            "INSERT OR REPLACE INTO collection_groups (collection_id, group_id, read_only, hide_passwords, manage) \
+             VALUES (?1, ?2, ?3, ?4, ?5)",
+            sel.id,
+            group_id,
+            sel.read_only,
+            sel.hide_passwords,
+            sel.manage
+        )
+        .map_err(|_| AppError::Database)?
+        .run()
+        .await?;
+    }
+    Ok(())
+}
