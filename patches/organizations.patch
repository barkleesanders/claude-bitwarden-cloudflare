+/// DELETE|POST /api/organizations/{id}/users/{ouid} — remove a member (Owner/Admin).
+#[worker::send]
+pub async fn remove_org_user(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Path((org_id, ouid)): Path<(String, String)>,
+) -> Result<Json<()>, AppError> {
+    let db = db::get_db(&env)?;
+    require_org_manage(&db, &claims.sub, &org_id).await?;
+    let member = fetch_membership(&db, &org_id, &ouid).await?;
+
+    if member.atype == TYPE_OWNER && confirmed_owner_count(&db, &org_id).await? <= 1 {
+        return Err(AppError::BadRequest(
+            "Cannot remove the last owner".to_string(),
+        ));
+    }
+    // Cascade removes the member's collection_users rows.
+    d1_query!(&db, "DELETE FROM organization_users WHERE id = ?1", member.id)
+        .map_err(|_| AppError::Database)?
+        .run()
+        .await?;
+    Ok(Json(()))
+}
