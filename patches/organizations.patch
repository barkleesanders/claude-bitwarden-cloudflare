+/// `organizationUserUserDetails` — a member row in GET /api/organizations/{id}/users.
+#[allow(clippy::too_many_arguments)]
+pub fn org_user_details(
+    id: &str,
+    user_id: &Option<String>,
+    name: &Option<String>,
+    email: &str,
+    atype: i64,
+    status: i64,
