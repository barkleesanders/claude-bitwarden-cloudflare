+/// PUT /api/ciphers/{id}/collections — set which collections an org cipher belongs to.
+#[worker::send]
+pub async fn set_cipher_collections(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Path(id): Path<String>,
+    Json(payload): Json<CipherCollectionsRequest>,
+) -> Result<Json<()>, AppError> {
+    let db = db::get_db(&env)?;
+    let now = db::now_string();
+
+    let row = fetch_cipher_by_id(&db, &id).await?;
+    let org_id = row
+        .organization_id
+        .clone()
+        .ok_or_else(|| AppError::BadRequest("Cipher is not in an organization".to_string()))?;
+    crate::handlers::organizations::require_org_member(&db, &claims.sub, &org_id).await?;
+
+    d1_query!(
+        &db,
+        "DELETE FROM collection_ciphers WHERE cipher_id = ?1",
+        id
+    )
+    .map_err(|_| AppError::Database)?
+    .run()
+    .await?;
+
+    for cid in &payload.collection_ids {
+        // Only link collections that belong to this cipher's org.
+        let belongs: Option<CollectionIdRow> = d1_query!(
+            &db,
+            "SELECT id FROM collections WHERE id = ?1 AND organization_id = ?2",
+            cid,
+            org_id
+        )
+        .map_err(|_| AppError::Database)?
+        .first(None)
+        .await?;
+        if belongs.is_none() {
+            continue;
+        }
+        d1_query!(
+            &db,
+            "INSERT OR IGNORE INTO collection_ciphers (collection_id, cipher_id) VALUES (?1, ?2)",
+            cid,
+            id
+        )
+        .map_err(|_| AppError::Database)?
+        .run()
+        .await?;
+    }
+
+    db::touch_user_updated_at(&db, &claims.sub, &now).await?;
+    Ok(Json(()))
+}
