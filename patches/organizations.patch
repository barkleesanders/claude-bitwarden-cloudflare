+/// Manual-confirm mode: when no email is wired up, invited existing accounts are
+/// set straight to Accepted (Vaultwarden's no-SMTP behavior) so the admin only
+/// needs to confirm. Set ORG_AUTO_ACCEPT_INVITES="false" to require explicit accept.
+fn auto_accept_invites(env: &Env) -> bool {
+    env.var("ORG_AUTO_ACCEPT_INVITES")
+        .map(|v| v.to_string() != "false")
+        .unwrap_or(true)
+}
