@@ -0,0 +1,331 @@
+use serde::Deserialize;
+use serde_json::{json, Value};
+
+// ---- Membership status / type constants (Bitwarden contract) ----
+#[allow(dead_code)]
+pub const STATUS_INVITED: i64 = 0;
+#[allow(dead_code)]
+pub const STATUS_ACCEPTED: i64 = 1;
+pub const STATUS_CONFIRMED: i64 = 2;
+
+pub const TYPE_OWNER: i64 = 0;
+#[allow(dead_code)]
+pub const TYPE_ADMIN: i64 = 1;
+#[allow(dead_code)]
+pub const TYPE_USER: i64 = 2;
+#[allow(dead_code)]
+pub const TYPE_MANAGER: i64 = 3;
+
+// ---- DB row structs (field names must match column names) ----
+
+#[derive(Debug, Deserialize)]
+pub struct Organization {
+    pub id: String,
+    pub name: String,
+    pub billing_email: String,
+    pub public_key: String,
+    pub private_key: String,
+    pub created_at: String,
+    pub updated_at: String,
+}
+
+// Several fields are persisted now but first read in Phase 2 (invites/ACL):
+// organization_id, email, created_at, updated_at.
+#[allow(dead_code)]
+#[derive(Debug, Deserialize)]
+pub struct OrganizationUser {
+    pub id: String,
+    pub organization_id: String,
+    pub user_id: Option<String>,
+    pub email: String,
+    pub akey: Option<String>,
+    pub status: i64,
+    pub atype: i64,
+    pub created_at: String,
+    pub updated_at: String,
+}
+
+#[derive(Debug, Deserialize)]
+pub struct Collection {
+    pub id: String,
+    pub organization_id: String,
+    pub name: String,
+    pub external_id: Option<String>,
+    pub created_at: String,
+    pub updated_at: String,
+}
+
+// ---- Request DTOs (camelCase from official clients) ----
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct OrgKeysData {
+    pub public_key: String,
+    pub encrypted_private_key: String,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CreateOrganizationRequest {
+    pub name: String,
+    #[serde(default)]
+    pub billing_email: String,
+    /// The org symmetric key wrapped with the creating user's RSA public key.
+    pub key: String,
+    /// The org RSA keypair (private key already encrypted with the org symmetric key).
+    pub keys: Option<OrgKeysData>,
+    /// Default collection name, encrypted with the org symmetric key.
+    #[serde(default)]
+    pub collection_name: Option<String>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CreateCollectionRequest {
+    pub name: String,
+    #[serde(default)]
+    pub external_id: Option<String>,
+    /// Members assigned to this collection (web vault sends these on create/update).
+    #[serde(default)]
+    pub users: Vec<CollectionAccessSelection>,
+}
+
+/// One collection's access flags for a member (used in invite + collection assignment).
+#[derive(Debug, Clone, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CollectionAccessSelection {
+    pub id: String,
+    #[serde(default)]
