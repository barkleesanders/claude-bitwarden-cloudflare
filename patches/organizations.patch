+// ---- Response builders (Bitwarden-compatible JSON) ----
+
+/// `OrganizationResponseModel` returned from create/get organization.
+pub fn organization_response(org: &Organization, member_type: i64) -> Value {
+    json!({
+        "id": org.id,
+        "name": org.name,
+        "billingEmail": org.billing_email,
+        "businessName": Value::Null,
+        "key": Value::Null,
+        "object": "organization",
+        "enabled": true,
+        "type": member_type,
+        "status": STATUS_CONFIRMED,
+        "useGroups": false,
+        "useDirectory": false,
+        "useEvents": false,
+        "useTotp": true,
+        "use2fa": true,
+        "usersGetPremium": true,
+        "useApi": true,
+        "usePolicies": false,
+        "useSso": false,
+        "useResetPassword": false,
+        "selfHost": true,
+        "hasPublicAndPrivateKeys": true,
+        "seats": Value::Null,
+        "maxCollections": Value::Null,
+        "maxStorageGb": Value::Null,
+        "identifier": Value::Null,
+    })
+}
+
+/// `profileOrganization` entry embedded in GET /api/sync `profile.organizations`.
+pub fn profile_organization(org_id: &str, name: &str, member: &OrganizationUser) -> Value {
+    let is_owner = member.atype == TYPE_OWNER;
+    let is_admin = member.atype <= TYPE_ADMIN;
+    json!({
+        "id": org_id,
+        "name": name,
+        "key": member.akey,
+        "status": member.status,
+        "type": member.atype,
+        "enabled": true,
+        "object": "profileOrganization",
+        "userId": member.user_id,
+        "useGroups": false,
+        "useDirectory": false,
+        "useEvents": false,
+        "useTotp": true,
+        "use2fa": true,
+        "useApi": true,
+        "usePolicies": false,
+        "useSso": false,
+        "useKeyConnector": false,
+        "useScim": false,
+        "useResetPassword": false,
+        "usersGetPremium": true,
+        "selfHost": true,
+        "hasPublicAndPrivateKeys": true,
+        "resetPasswordEnrolled": false,
+        "seats": Value::Null,
+        "maxCollections": Value::Null,
+        "maxStorageGb": Value::Null,
+        "ssoBound": false,
+        "identifier": Value::Null,
+        "permissions": {
+            "accessEventLogs": is_admin,
+            "accessImportExport": is_admin,
+            "accessReports": is_admin,
+            "createNewCollections": is_admin,
+            "editAnyCollection": is_admin,
+            "deleteAnyCollection": is_admin,
+            "manageGroups": is_admin,
+            "managePolicies": is_owner,
+            "manageSso": is_owner,
+            "manageUsers": is_admin,
+            "manageResetPassword": is_owner,
+            "manageScim": is_owner
+        },
+        "providerId": Value::Null,
+        "providerName": Value::Null,
+        "familySponsorshipFriendlyName": Value::Null,
+        "keyConnectorEnabled": false,
+        "keyConnectorUrl": Value::Null,
+    })
+}
+
+/// `collection` object (GET /api/organizations/{id}/collections).
+pub fn collection_response(col: &Collection) -> Value {
+    json!({
+        "id": col.id,
+        "organizationId": col.organization_id,
+        "name": col.name,
+        "externalId": col.external_id,
+        "object": "collection",
+    })
+}
+
+/// One `{id, readOnly, hidePasswords, manage}` collection-access entry.
+pub fn collection_membership(
+    collection_id: &str,
+    read_only: bool,
+    hide_passwords: bool,
+    manage: bool,
+) -> Value {
+    json!({
+        "id": collection_id,
+        "readOnly": read_only,
+        "hidePasswords": hide_passwords,
+        "manage": manage,
+    })
+}
