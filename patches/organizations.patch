+++ b/src/handlers/organizations.rs
@@ -0,0 +1,1585 @@
+use axum::extract::{Path, State};
+use axum::Json;
+use serde::Deserialize;
+use serde_json::{json, Value};
+use std::sync::Arc;
+use uuid::Uuid;
+use worker::Env;
+
+use crate::auth::Claims;
+use crate::db::{self, touch_user_updated_at, Db};
+use crate::error::AppError;
+use crate::handlers::events::{self, Target};
+use crate::models::organization::{
+    collection_details, collection_membership, collection_response, group_response,
+    org_user_details, organization_response, policy_response, profile_organization,
+    AcceptInviteRequest, Collection, CollectionAccessSelection, ConfirmUserRequest,
+    CreateCollectionRequest, CreateGroupRequest, CreateOrganizationRequest, Group,
+    InviteUsersRequest, Organization, OrganizationUser, PutCollectionUsersRequest,
+    PutGroupUsersRequest, PutPolicyRequest, UpdateOrgUserRequest, UpdateOrganizationRequest,
+    STATUS_ACCEPTED, STATUS_CONFIRMED, STATUS_INVITED, TYPE_ADMIN, TYPE_OWNER,
+};
+use crate::d1_query;
+
+// ============================================================================
+// ACL helpers
+// ============================================================================
+
+/// Return this user's confirmed membership in `org_id`, or an error if they are
+/// not a member. This is the access boundary for every organization endpoint.
+pub async fn require_org_member(
+    db: &Db,
+    user_id: &str,
+    org_id: &str,
+) -> Result<OrganizationUser, AppError> {
+    let member: Option<OrganizationUser> = d1_query!(
+        db,
+        "SELECT * FROM organization_users WHERE organization_id = ?1 AND user_id = ?2",
+        org_id,
+        user_id
+    )
+    .map_err(|_| AppError::Database)?
+    .first(None)
+    .await?;
+
+    member.ok_or_else(|| AppError::NotFound("Organization not found".to_string()))
+}
+
+/// Require that the user can manage the organization's collections (Owner or Admin).
+pub async fn require_org_manage(
+    db: &Db,
+    user_id: &str,
+    org_id: &str,
+) -> Result<OrganizationUser, AppError> {
+    let member = require_org_member(db, user_id, org_id).await?;
+    if member.atype <= TYPE_ADMIN {
+        Ok(member)
+    } else {
+        Err(AppError::Unauthorized(
+            "You do not have permission to manage this organization".to_string(),
+        ))
+    }
+}
+
+// ============================================================================
+// Sync helpers (called from handlers::sync)
+// ============================================================================
+
+#[derive(Debug, Deserialize)]
+struct ProfileOrgRow {
+    org_name: String,
+    id: String,
+    organization_id: String,
+    user_id: Option<String>,
+    email: String,
+    akey: Option<String>,
+    status: i64,
+    atype: i64,
+    created_at: String,
+    updated_at: String,
+}
+
+/// Build the `profile.organizations` array for GET /api/sync.
+pub async fn build_profile_organizations(
+    db: &Db,
+    user_id: &str,
+) -> Result<Vec<Value>, AppError> {
+    let rows: Vec<ProfileOrgRow> = d1_query!(
+        db,
+        "SELECT o.name AS org_name, ou.id AS id, ou.organization_id AS organization_id, \
+                ou.user_id AS user_id, ou.email AS email, ou.akey AS akey, \
+                ou.status AS status, ou.atype AS atype, \
+                ou.created_at AS created_at, ou.updated_at AS updated_at \
+         FROM organization_users ou JOIN organizations o ON o.id = ou.organization_id \
+         WHERE ou.user_id = ?1",
+        user_id
+    )
+    .map_err(|_| AppError::Database)?
+    .all()
+    .await?
+    .results()
+    .map_err(|_| AppError::Database)?;
+
+    Ok(rows
+        .into_iter()
+        .map(|r| {
+            let org_id = r.organization_id.clone();
+            let org_name = r.org_name.clone();
+            let member = OrganizationUser {
+                id: r.id,
+                organization_id: r.organization_id,
+                user_id: r.user_id,
+                email: r.email,
+                akey: r.akey,
+                status: r.status,
+                atype: r.atype,
+                created_at: r.created_at,
+                updated_at: r.updated_at,
+            };
+            profile_organization(&org_id, &org_name, &member)
+        })
+        .collect())
+}
+
+#[derive(Debug, Deserialize)]
+struct UserCollectionRow {
+    id: String,
+    organization_id: String,
+    name: String,
+    external_id: Option<String>,
+    atype: i64,
+}
+
+/// Build the `collections` array (collectionDetails) for GET /api/sync.
+///
+/// Phase 1: a user is always an Owner of orgs they create, so they `manage` every
+/// collection. When non-owner members + per-collection ACLs land (Phase 2) the
+/// flags are read from `collection_users` instead of derived from member type.
+pub async fn build_user_collections(db: &Db, user_id: &str) -> Result<Vec<Value>, AppError> {
+    let rows: Vec<UserCollectionRow> = d1_query!(
+        db,
+        "SELECT c.id AS id, c.organization_id AS organization_id, c.name AS name, \
+                c.external_id AS external_id, ou.atype AS atype \
+         FROM collections c \
+         JOIN organization_users ou ON ou.organization_id = c.organization_id \
+         WHERE ou.user_id = ?1 AND ou.status = ?2",
+        user_id,
+        STATUS_CONFIRMED
+    )
+    .map_err(|_| AppError::Database)?
+    .all()
+    .await?
+    .results()
+    .map_err(|_| AppError::Database)?;
+
+    Ok(rows
+        .into_iter()
+        .map(|r| {
+            let manage = r.atype <= TYPE_ADMIN;
+            collection_details(
+                &r.id,
+                &r.organization_id,
+                &r.name,
+                &r.external_id,
+                false,
+                false,
+                manage,
+            )
+        })
+        .collect())
+}
+
+// ============================================================================
+// Organization endpoints
+// ============================================================================
+
+#[derive(Debug, Deserialize)]
+struct EmailRow {
+    email: String,
+}
+
+/// POST /api/organizations — create a new organization owned by the caller.
+#[worker::send]
+pub async fn create_organization(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Json(payload): Json<CreateOrganizationRequest>,
+) -> Result<Json<Value>, AppError> {
+    let db = db::get_db(&env)?;
+    let now = db::now_string();
+    let user_id = claims.sub.clone();
+
+    let keys = payload
+        .keys
+        .ok_or_else(|| AppError::BadRequest("Organization keys are required".to_string()))?;
+
+    // Caller's email is used as the membership email + default billing email.
+    let email_row: EmailRow = d1_query!(&db, "SELECT email FROM users WHERE id = ?1", user_id)
+        .map_err(|_| AppError::Database)?
+        .first(None)
+        .await?
+        .ok_or_else(|| AppError::NotFound("User not found".to_string()))?;
+    let billing_email = if payload.billing_email.is_empty() {
+        email_row.email.clone()
+    } else {
+        payload.billing_email.clone()
+    };
+
+    let org = Organization {
+        id: Uuid::new_v4().to_string(),
+        name: payload.name,
+        billing_email,
+        public_key: keys.public_key,
+        private_key: keys.encrypted_private_key,
+        created_at: now.clone(),
+        updated_at: now.clone(),
+    };
+
+    d1_query!(
+        &db,
+        "INSERT INTO organizations (id, name, billing_email, public_key, private_key, created_at, updated_at) \
+         VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7)",
+        org.id,
+        org.name,
+        org.billing_email,
+        org.public_key,
+        org.private_key,
+        org.created_at,
+        org.updated_at
+    )
+    .map_err(|_| AppError::Database)?
+    .run()
+    .await?;
+
+    // Owner membership: confirmed, holds the user-wrapped org key.
+    let owner_membership_id = Uuid::new_v4().to_string();
+    d1_query!(
+        &db,
+        "INSERT INTO organization_users (id, organization_id, user_id, email, akey, status, atype, created_at, updated_at) \
+         VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8, ?9)",
+        owner_membership_id,
+        org.id,
+        user_id,
+        email_row.email,
+        payload.key,
+        STATUS_CONFIRMED,
+        TYPE_OWNER,
+        now,
+        now
+    )
+    .map_err(|_| AppError::Database)?
+    .run()
+    .await?;
+
+    // Default collection (the client sends its encrypted name).
+    if let Some(collection_name) = payload.collection_name {
+        let collection_id = Uuid::new_v4().to_string();
+        d1_query!(
+            &db,
+            "INSERT INTO collections (id, organization_id, name, external_id, created_at, updated_at) \
+             VALUES (?1, ?2, ?3, NULL, ?4, ?5)",
+            collection_id,
+            org.id,
+            collection_name,
+            now,
+            now
+        )
+        .map_err(|_| AppError::Database)?
+        .run()
+        .await?;
+
+        d1_query!(
+            &db,
+            "INSERT INTO collection_users (collection_id, organization_user_id, read_only, hide_passwords, manage) \
+             VALUES (?1, ?2, 0, 0, 1)",
+            collection_id,
+            owner_membership_id
+        )
+        .map_err(|_| AppError::Database)?
+        .run()
+        .await?;
+    }
+
+    touch_user_updated_at(&db, &user_id, &now).await?;
+    events::log_event(&db, &org.id, events::ORG_CREATED, &user_id, Target::None).await;
+
+    Ok(Json(organization_response(&org, TYPE_OWNER)))
+}
+
+/// GET /api/organizations/{id} — organization profile (members only).
+#[worker::send]
+pub async fn get_organization(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Path(org_id): Path<String>,
+) -> Result<Json<Value>, AppError> {
+    let db = db::get_db(&env)?;
+    let member = require_org_member(&db, &claims.sub, &org_id).await?;
+
+    let org: Organization = d1_query!(&db, "SELECT * FROM organizations WHERE id = ?1", org_id)
+        .map_err(|_| AppError::Database)?
+        .first(None)
+        .await?
+        .ok_or_else(|| AppError::NotFound("Organization not found".to_string()))?;
+
+    Ok(Json(organization_response(&org, member.atype)))
+}
+
+// ============================================================================
+// Collection endpoints
+// ============================================================================
+
+fn collection_list(items: Vec<Value>) -> Value {
+    json!({ "data": items, "object": "list", "continuationToken": Value::Null })
+}
+
+/// GET /api/organizations/{id}/collections — collections in an org (members only).
+#[worker::send]
+pub async fn list_org_collections(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Path(org_id): Path<String>,
+) -> Result<Json<Value>, AppError> {
+    let db = db::get_db(&env)?;
+    require_org_member(&db, &claims.sub, &org_id).await?;
+
+    let cols: Vec<Collection> = d1_query!(
+        &db,
+        "SELECT * FROM collections WHERE organization_id = ?1",
+        org_id
+    )
+    .map_err(|_| AppError::Database)?
+    .all()
+    .await?
+    .results()
+    .map_err(|_| AppError::Database)?;
+
+    let items = cols.iter().map(collection_response).collect();
+    Ok(Json(collection_list(items)))
+}
+
+/// GET /api/collections — every collection the caller can access, across all orgs.
+#[worker::send]
+pub async fn list_collections(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+) -> Result<Json<Value>, AppError> {
+    let db = db::get_db(&env)?;
+    let items = build_user_collections(&db, &claims.sub).await?;
+    Ok(Json(collection_list(items)))
+}
+
+/// POST /api/organizations/{id}/collections — create a collection (Owner/Admin).
+#[worker::send]
+pub async fn create_collection(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Path(org_id): Path<String>,
+    Json(payload): Json<CreateCollectionRequest>,
+) -> Result<Json<Value>, AppError> {
+    let db = db::get_db(&env)?;
+    let member = require_org_manage(&db, &claims.sub, &org_id).await?;
+    let now = db::now_string();
+
+    let col = Collection {
+        id: Uuid::new_v4().to_string(),
+        organization_id: org_id,
+        name: payload.name,
+        external_id: payload.external_id,
+        created_at: now.clone(),
+        updated_at: now.clone(),
+    };
+
+    d1_query!(
+        &db,
+        "INSERT INTO collections (id, organization_id, name, external_id, created_at, updated_at) \
+         VALUES (?1, ?2, ?3, ?4, ?5, ?6)",
+        col.id,
+        col.organization_id,
+        col.name,
+        col.external_id,
+        col.created_at,
+        col.updated_at
+    )
+    .map_err(|_| AppError::Database)?
+    .run()
+    .await?;
+
+    // Grant the creating member manage access to the new collection.
+    d1_query!(
+        &db,
+        "INSERT INTO collection_users (collection_id, organization_user_id, read_only, hide_passwords, manage) \
+         VALUES (?1, ?2, 0, 0, 1)",
+        col.id,
+        member.id
+    )
+    .map_err(|_| AppError::Database)?
+    .run()
+    .await?;
+
+    // Assign any additional members the client specified (each id is an org_user id).
+    for sel in &payload.users {
+        let in_org: Option<IdRow> = d1_query!(
+            &db,
+            "SELECT id FROM organization_users WHERE id = ?1 AND organization_id = ?2",
+            sel.id,
+            col.organization_id
+        )
+        .map_err(|_| AppError::Database)?
+        .first(None)
+        .await?;
+        if in_org.is_none() {
+            continue;
+        }
+        d1_query!(
+            &db,
+            "INSERT OR REPLACE INTO collection_users (collection_id, organization_user_id, read_only, hide_passwords, manage) \
+             VALUES (?1, ?2, ?3, ?4, ?5)",
+            col.id,
+            sel.id,
+            sel.read_only,
+            sel.hide_passwords,
+            sel.manage
+        )
+        .map_err(|_| AppError::Database)?
+        .run()
+        .await?;
+    }
+
+    events::log_event(&db, &col.organization_id, events::COLLECTION_CREATED, &claims.sub, Target::Collection(&col.id)).await;
+    Ok(Json(collection_response(&col)))
+}
+
+/// PUT|POST /api/organizations/{id}/collections/{cid} — rename a collection (Owner/Admin).
+#[worker::send]
+pub async fn update_collection(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Path((org_id, collection_id)): Path<(String, String)>,
+    Json(payload): Json<CreateCollectionRequest>,
+) -> Result<Json<Value>, AppError> {
+    let db = db::get_db(&env)?;
+    require_org_manage(&db, &claims.sub, &org_id).await?;
+    let now = db::now_string();
+
+    let existing: Collection = d1_query!(
+        &db,
+        "SELECT * FROM collections WHERE id = ?1 AND organization_id = ?2",
+        collection_id,
+        org_id
+    )
+    .map_err(|_| AppError::Database)?
+    .first(None)
+    .await?
+    .ok_or_else(|| AppError::NotFound("Collection not found".to_string()))?;
+
+    let col = Collection {
+        id: existing.id,
+        organization_id: existing.organization_id,
+        name: payload.name,
+        external_id: payload.external_id,
+        created_at: existing.created_at,
+        updated_at: now,
+    };
+
+    d1_query!(
+        &db,
+        "UPDATE collections SET name = ?1, external_id = ?2, updated_at = ?3 WHERE id = ?4",
+        col.name,
+        col.external_id,
+        col.updated_at,
+        col.id
+    )
+    .map_err(|_| AppError::Database)?
+    .run()
+    .await?;
+
+    Ok(Json(collection_response(&col)))
+}
+
+/// DELETE /api/organizations/{id}/collections/{cid} — delete a collection (Owner/Admin).
+/// Cascades remove collection_users + collection_ciphers rows (ciphers themselves remain).
+#[worker::send]
+pub async fn delete_collection(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Path((org_id, collection_id)): Path<(String, String)>,
+) -> Result<Json<()>, AppError> {
+    let db = db::get_db(&env)?;
+    require_org_manage(&db, &claims.sub, &org_id).await?;
+
+    d1_query!(
+        &db,
+        "DELETE FROM collections WHERE id = ?1 AND organization_id = ?2",
+        collection_id,
+        org_id
+    )
+    .map_err(|_| AppError::Database)?
+    .run()
+    .await?;
+
+    events::log_event(&db, &org_id, events::COLLECTION_DELETED, &claims.sub, Target::Collection(&collection_id)).await;
+    Ok(Json(()))
+}
+
+// ============================================================================
+// Shared helpers for membership + collection assignment
+// ============================================================================
+
+#[derive(Debug, Deserialize)]
+struct IdRow {
+    #[allow(dead_code)]
+    id: String,
+}
+
+#[derive(Debug, Deserialize)]
+struct UserLookupRow {
+    id: String,
+    name: Option<String>,
+}
+
+#[derive(Debug, Deserialize)]
+struct OrgNameRow {
+    name: String,
+}
+
+/// Look up an existing account by email (emails are UNIQUE).
+async fn resolve_user_by_email(db: &Db, email: &str) -> Result<Option<UserLookupRow>, AppError> {
+    d1_query!(db, "SELECT id, name FROM users WHERE email = ?1", email)
+        .map_err(|_| AppError::Database)?
+        .first(None)
+        .await
+        .map_err(|_| AppError::Database)
+}
+
+/// Replace a member's per-collection access rows. Selections referencing a
+/// collection outside this org are silently ignored (cross-org guard).
+async fn assign_member_collections(
+    db: &Db,
+    org_id: &str,
+    org_user_id: &str,
+    selections: &[CollectionAccessSelection],
+) -> Result<(), AppError> {
+    d1_query!(
+        db,
+        "DELETE FROM collection_users WHERE organization_user_id = ?1",
+        org_user_id
+    )
+    .map_err(|_| AppError::Database)?
+    .run()
+    .await?;
+
+    for sel in selections {
+        let belongs: Option<IdRow> = d1_query!(
+            db,
+            "SELECT id FROM collections WHERE id = ?1 AND organization_id = ?2",
+            sel.id,
+            org_id
+        )
+        .map_err(|_| AppError::Database)?
+        .first(None)
+        .await?;
+        if belongs.is_none() {
+            continue;
+        }
+        d1_query!(
+            db,
+            "INSERT INTO collection_users (collection_id, organization_user_id, read_only, hide_passwords, manage) \
+             VALUES (?1, ?2, ?3, ?4, ?5)",
+            sel.id,
+            org_user_id,
+            sel.read_only,
+            sel.hide_passwords,
+            sel.manage
+        )
+        .map_err(|_| AppError::Database)?
+        .run()
+        .await?;
+    }
+    Ok(())
+}
