+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct InviteUsersRequest {
+    pub emails: Vec<String>,
+    #[serde(rename = "type")]
+    pub atype: i64,
+    #[serde(default)]
+    pub collections: Vec<CollectionAccessSelection>,
+    // access_all = "member can see every collection without explicit assignment".
+    // Phase 3 (needs a membership column); owners/admins already see all via atype.
+    #[allow(dead_code)]
+    #[serde(default)]
+    pub access_all: bool,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ConfirmUserRequest {
