+/// Number of confirmed owners in an org (used to protect the last owner).
+async fn confirmed_owner_count(db: &Db, org_id: &str) -> Result<i64, AppError> {
+    let row: Option<CountRow> = d1_query!(
+        db,
+        "SELECT COUNT(*) AS n FROM organization_users WHERE organization_id = ?1 AND atype = ?2 AND status = ?3",
