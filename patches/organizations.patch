+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CipherCollectionsRequest {
+    #[serde(default)]
+    pub collection_ids: Vec<String>,
+}
+
+#[derive(Debug, Deserialize)]
+struct CollectionIdRow {
+    #[allow(dead_code)]
+    id: String,
+}
+
+/// Fetch a cipher row by id only (not scoped to a user). Used for org ciphers.
+/// Coalesces a NULL user_id to "" so org-owned ciphers deserialize into CipherDBModel.
+async fn fetch_cipher_by_id(db: &crate::db::Db, id: &str) -> Result<CipherDBModel, AppError> {
+    db.prepare(
+        "SELECT id, COALESCE(user_id, '') AS user_id, organization_id, type, data, favorite, \
+                folder_id, deleted_at, archived_at, created_at, updated_at \
+         FROM ciphers WHERE id = ?1",
+    )
+    .bind(&[id.to_string().into()])?
+    .first(None)
+    .await
+    .map_err(|_| AppError::Database)?
+    .ok_or_else(|| AppError::NotFound("Cipher not found".to_string()))
+}
+
+/// Is this user an Owner/Admin of the given org?
+async fn is_org_manager(db: &crate::db::Db, org_id: &str, user_id: &str) -> Result<bool, AppError> {
+    let row: Option<CollectionIdRow> = db
+        .prepare("SELECT id FROM organization_users WHERE organization_id = ?1 AND user_id = ?2 AND status = 2 AND atype <= 1")
+        .bind(&[org_id.to_string().into(), user_id.to_string().into()])?
+        .first(None)
+        .await
+        .map_err(|_| AppError::Database)?;
+    Ok(row.is_some())
+}
+
+/// Can the user READ this cipher (own it, or org admin, or assigned to a collection holding it)?
+async fn user_can_access_cipher(
+    db: &crate::db::Db,
+    cipher: &CipherDBModel,
+    user_id: &str,
+) -> Result<bool, AppError> {
+    if cipher.user_id == user_id {
+        return Ok(true);
+    }
+    let org_id = match cipher.organization_id.as_deref() {
+        Some(o) => o,
+        None => return Ok(false),
+    };
+    if is_org_manager(db, org_id, user_id).await? {
+        return Ok(true);
+    }
+    let row: Option<CollectionIdRow> = db
+        .prepare(
+            "SELECT cc.cipher_id AS id FROM collection_ciphers cc \
+             JOIN collection_users cu ON cu.collection_id = cc.collection_id \
+             JOIN organization_users ou ON ou.id = cu.organization_user_id \
+             WHERE cc.cipher_id = ?1 AND ou.user_id = ?2 AND ou.status = 2",
+        )
+        .bind(&[cipher.id.clone().into(), user_id.to_string().into()])?
+        .first(None)
+        .await
+        .map_err(|_| AppError::Database)?;
+    if row.is_some() {
+        return Ok(true);
+    }
+    // Access via a group the user belongs to.
+    let grp: Option<CollectionIdRow> = db
+        .prepare(
+            "SELECT cc.cipher_id AS id FROM collection_ciphers cc \
+             JOIN collection_groups cg ON cg.collection_id = cc.collection_id \
+             JOIN group_users gu ON gu.group_id = cg.group_id \
+             JOIN organization_users ou ON ou.id = gu.organization_user_id \
+             WHERE cc.cipher_id = ?1 AND ou.user_id = ?2 AND ou.status = 2",
+        )
+        .bind(&[cipher.id.clone().into(), user_id.to_string().into()])?
+        .first(None)
+        .await
+        .map_err(|_| AppError::Database)?;
+    Ok(grp.is_some())
+}
+
+/// Can the user EDIT this cipher (own it, or org admin, or `manage` on a holding collection)?
+async fn user_can_manage_cipher(
+    db: &crate::db::Db,
+    cipher: &CipherDBModel,
+    user_id: &str,
+) -> Result<bool, AppError> {
+    if cipher.user_id == user_id {
+        return Ok(true);
+    }
+    let org_id = match cipher.organization_id.as_deref() {
+        Some(o) => o,
+        None => return Ok(false),
+    };
+    if is_org_manager(db, org_id, user_id).await? {
+        return Ok(true);
+    }
+    let row: Option<CollectionIdRow> = db
+        .prepare(
+            "SELECT cc.cipher_id AS id FROM collection_ciphers cc \
+             JOIN collection_users cu ON cu.collection_id = cc.collection_id \
+             JOIN organization_users ou ON ou.id = cu.organization_user_id \
+             WHERE cc.cipher_id = ?1 AND ou.user_id = ?2 AND ou.status = 2 AND cu.manage = 1",
+        )
+        .bind(&[cipher.id.clone().into(), user_id.to_string().into()])?
+        .first(None)
+        .await
+        .map_err(|_| AppError::Database)?;
+    if row.is_some() {
+        return Ok(true);
+    }
+    // Manage via a group with manage rights on a holding collection.
+    let grp: Option<CollectionIdRow> = db
+        .prepare(
+            "SELECT cc.cipher_id AS id FROM collection_ciphers cc \
+             JOIN collection_groups cg ON cg.collection_id = cc.collection_id \
+             JOIN group_users gu ON gu.group_id = cg.group_id \
+             JOIN organization_users ou ON ou.id = gu.organization_user_id \
+             WHERE cc.cipher_id = ?1 AND ou.user_id = ?2 AND ou.status = 2 AND cg.manage = 1",
+        )
+        .bind(&[cipher.id.clone().into(), user_id.to_string().into()])?
+        .first(None)
+        .await
+        .map_err(|_| AppError::Database)?;
+    Ok(grp.is_some())
+}
+
+/// Fetch a cipher the user may READ (personal or accessible org cipher).
+async fn fetch_cipher_for_read(
+    db: &crate::db::Db,
+    id: &str,
+    user_id: &str,
+) -> Result<CipherDBModel, AppError> {
+    let c = fetch_cipher_by_id(db, id).await?;
+    if user_can_access_cipher(db, &c, user_id).await? {
+        Ok(c)
+    } else {
+        Err(AppError::NotFound("Cipher not found".to_string()))
+    }
+}
+
+/// Fetch a cipher the user may EDIT (personal or manageable org cipher).
+async fn fetch_cipher_for_edit(
+    db: &crate::db::Db,
+    id: &str,
+    user_id: &str,
+) -> Result<CipherDBModel, AppError> {
+    let c = fetch_cipher_by_id(db, id).await?;
+    if user_can_manage_cipher(db, &c, user_id).await? {
+        Ok(c)
+    } else {
+        Err(AppError::NotFound("Cipher not found".to_string()))
+    }
+}
+
+/// PUT /api/ciphers/{id}/share — move a personal cipher into an organization.
+/// The body carries the cipher re-encrypted with the org key + target collectionIds.
+#[worker::send]
+pub async fn share_cipher(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Path(id): Path<String>,
+    Json(payload): Json<CreateCipherRequest>,
+) -> Result<Json<Cipher>, AppError> {
+    let db = db::get_db(&env)?;
+    let now = db::now_string();
+    let cipher_data_req = payload.cipher;
+    let org_id = cipher_data_req
+        .organization_id
+        .clone()
+        .ok_or_else(|| AppError::BadRequest("organizationId is required to share".to_string()))?;
+
+    // Must currently own the personal cipher, and be a member of the target org.
+    fetch_cipher_for_user(&db, &id, &claims.sub).await?;
+    crate::handlers::organizations::require_org_member(&db, &claims.sub, &org_id).await?;
+
+    let cipher_data = CipherData::new(
+        cipher_data_req.name,
+        cipher_data_req.notes,
+        cipher_data_req.type_fields,
+    );
+    let data_value = serde_json::to_value(&cipher_data).map_err(|_| AppError::Internal)?;
+    let data = serde_json::to_string(&data_value).map_err(|_| AppError::Internal)?;
+
+    d1_query!(
+        &db,
+        "UPDATE ciphers SET user_id = NULL, organization_id = ?1, data = ?2, folder_id = ?3, updated_at = ?4 WHERE id = ?5",
+        org_id,
+        data,
+        cipher_data_req.folder_id,
+        now,
+        id
+    )
+    .map_err(|_| AppError::Database)?
+    .run()
+    .await?;
+
+    for cid in &payload.collection_ids {
+        // Only link collections that belong to the target org (cross-org guard).
+        let belongs: Option<CollectionIdRow> = d1_query!(
+            &db,
+            "SELECT id FROM collections WHERE id = ?1 AND organization_id = ?2",
+            cid,
+            org_id
+        )
+        .map_err(|_| AppError::Database)?
+        .first(None)
+        .await?;
+        if belongs.is_none() {
+            continue;
+        }
+        d1_query!(
+            &db,
+            "INSERT OR IGNORE INTO collection_ciphers (collection_id, cipher_id) VALUES (?1, ?2)",
+            cid,
+            id
+        )
+        .map_err(|_| AppError::Database)?
+        .run()
+        .await?;
+    }
+
+    db::touch_user_updated_at(&db, &claims.sub, &now).await?;
+    notifications::publish_cipher_update(
+        (*env).clone(),
+        claims.sub.clone(),
+        UpdateType::SyncCipherUpdate,
+        id.clone(),
+        now.clone(),
+        Some(claims.device.clone()),
+    );
+
+    let mut cipher: Cipher = fetch_cipher_by_id(&db, &id).await?.into();
+    attachments::hydrate_cipher_attachments(&db, env.as_ref(), &mut cipher).await?;
+    Ok(Json(cipher))
+}
+
+/// PUT /api/ciphers/{id}/collections — set which collections an org cipher belongs to.
+#[worker::send]
+pub async fn set_cipher_collections(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Path(id): Path<String>,
+    Json(payload): Json<CipherCollectionsRequest>,
+) -> Result<Json<()>, AppError> {
+    let db = db::get_db(&env)?;
+    let now = db::now_string();
+
+    let row = fetch_cipher_by_id(&db, &id).await?;
+    let org_id = row
+        .organization_id
+        .clone()
+        .ok_or_else(|| AppError::BadRequest("Cipher is not in an organization".to_string()))?;
+    crate::handlers::organizations::require_org_member(&db, &claims.sub, &org_id).await?;
+
+    d1_query!(
+        &db,
+        "DELETE FROM collection_ciphers WHERE cipher_id = ?1",
+        id
+    )
+    .map_err(|_| AppError::Database)?
+    .run()
+    .await?;
+
+    for cid in &payload.collection_ids {
+        // Only link collections that belong to this cipher's org.
+        let belongs: Option<CollectionIdRow> = d1_query!(
+            &db,
+            "SELECT id FROM collections WHERE id = ?1 AND organization_id = ?2",
+            cid,
+            org_id
+        )
+        .map_err(|_| AppError::Database)?
+        .first(None)
+        .await?;
+        if belongs.is_none() {
+            continue;
+        }
+        d1_query!(
+            &db,
+            "INSERT OR IGNORE INTO collection_ciphers (collection_id, cipher_id) VALUES (?1, ?2)",
+            cid,
+            id
+        )
+        .map_err(|_| AppError::Database)?
+        .run()
+        .await?;
+    }
+
+    db::touch_user_updated_at(&db, &claims.sub, &now).await?;
+    Ok(Json(()))
+}
