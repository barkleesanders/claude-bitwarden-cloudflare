+/// PUT /api/ciphers/{id}/share — move a personal cipher into an organization.
+/// The body carries the cipher re-encrypted with the org key + target collectionIds.
+#[worker::send]
+pub async fn share_cipher(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Path(id): Path<String>,
+    Json(payload): Json<CreateCipherRequest>,
+) -> Result<Json<Cipher>, AppError> {
+    let db = db::get_db(&env)?;
+    let now = db::now_string();
+    let cipher_data_req = payload.cipher;
+    let org_id = cipher_data_req
+        .organization_id
+        .clone()
+        .ok_or_else(|| AppError::BadRequest("organizationId is required to share".to_string()))?;
+
+    // Must currently own the personal cipher, and be a member of the target org.
+    fetch_cipher_for_user(&db, &id, &claims.sub).await?;
+    crate::handlers::organizations::require_org_member(&db, &claims.sub, &org_id).await?;
+
+    let cipher_data = CipherData::new(
+        cipher_data_req.name,
+        cipher_data_req.notes,
+        cipher_data_req.type_fields,
+    );
+    let data_value = serde_json::to_value(&cipher_data).map_err(|_| AppError::Internal)?;
+    let data = serde_json::to_string(&data_value).map_err(|_| AppError::Internal)?;
+
+    d1_query!(
+        &db,
+        "UPDATE ciphers SET user_id = NULL, organization_id = ?1, data = ?2, folder_id = ?3, updated_at = ?4 WHERE id = ?5",
+        org_id,
+        data,
+        cipher_data_req.folder_id,
+        now,
+        id
+    )
+    .map_err(|_| AppError::Database)?
+    .run()
+    .await?;
+
+    for cid in &payload.collection_ids {
+        // Only link collections that belong to the target org (cross-org guard).
+        let belongs: Option<CollectionIdRow> = d1_query!(
+            &db,
+            "SELECT id FROM collections WHERE id = ?1 AND organization_id = ?2",
+            cid,
+            org_id
+        )
+        .map_err(|_| AppError::Database)?
+        .first(None)
+        .await?;
+        if belongs.is_none() {
+            continue;
+        }
+        d1_query!(
+            &db,
+            "INSERT OR IGNORE INTO collection_ciphers (collection_id, cipher_id) VALUES (?1, ?2)",
+            cid,
+            id
+        )
+        .map_err(|_| AppError::Database)?
+        .run()
+        .await?;
+    }
+
+    db::touch_user_updated_at(&db, &claims.sub, &now).await?;
+    notifications::publish_cipher_update(
+        (*env).clone(),
+        claims.sub.clone(),
+        UpdateType::SyncCipherUpdate,
+        id.clone(),
+        now.clone(),
+        Some(claims.device.clone()),
+    );
+
+    let mut cipher: Cipher = fetch_cipher_by_id(&db, &id).await?.into();
+    attachments::hydrate_cipher_attachments(&db, env.as_ref(), &mut cipher).await?;
+    Ok(Json(cipher))
+}
