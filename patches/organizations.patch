+/// POST /api/organizations/{id}/users/invite — invite members by email (Owner/Admin).
+///
+/// Cloudflare-native: no external email required. Existing accounts become members
+/// immediately (Accepted in manual-confirm mode); the admin then confirms with the
+/// member's wrapped key. Emails without an account on this vault are reported back.
+#[worker::send]
+pub async fn invite_users(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Path(org_id): Path<String>,
+    Json(payload): Json<InviteUsersRequest>,
+) -> Result<Json<Value>, AppError> {
+    let db = db::get_db(&env)?;
+    require_org_manage(&db, &claims.sub, &org_id).await?;
+    let now = db::now_string();
+    let accepted_status = if auto_accept_invites(&env) {
+        STATUS_ACCEPTED
+    } else {
+        STATUS_INVITED
+    };
+    // Org name for the optional notification email (best-effort).
+    let org_name = d1_query!(&db, "SELECT name FROM organizations WHERE id = ?1", org_id)
+        .map_err(|_| AppError::Database)?
+        .first::<OrgNameRow>(None)
+        .await?
+        .map(|r| r.name)
+        .unwrap_or_default();
+
+    let mut not_found: Vec<String> = Vec::new();
+    for email in &payload.emails {
+        let email = email.trim().to_lowercase();
+        if email.is_empty() {
+            continue;
+        }
+        let user = resolve_user_by_email(&db, &email).await?;
+        let (user_id, status) = match user {
+            Some(u) => (Some(u.id), accepted_status),
+            None => {
+                not_found.push(email.clone());
+                (None, STATUS_INVITED)
+            }
+        };
+
+        // Skip if this account is already a member.
+        if let Some(ref uid) = user_id {
+            let existing: Option<IdRow> = d1_query!(
+                &db,
+                "SELECT id FROM organization_users WHERE organization_id = ?1 AND user_id = ?2",
+                org_id,
+                uid
+            )
+            .map_err(|_| AppError::Database)?
+            .first(None)
+            .await?;
+            if existing.is_some() {
+                continue;
+            }
+        }
+
+        let ouid = Uuid::new_v4().to_string();
+        d1_query!(
+            &db,
+            "INSERT INTO organization_users (id, organization_id, user_id, email, akey, status, atype, created_at, updated_at) \
+             VALUES (?1, ?2, ?3, ?4, NULL, ?5, ?6, ?7, ?8)",
+            ouid,
+            org_id,
+            user_id,
+            email,
+            status,
+            payload.atype,
+            now,
+            now
+        )
+        .map_err(|_| AppError::Database)?
+        .run()
+        .await?;
+
+        assign_member_collections(&db, &org_id, &ouid, &payload.collections).await?;
+        events::log_event(&db, &org_id, events::MEMBER_INVITED, &claims.sub, Target::Member(&ouid)).await;
+        crate::handlers::email::send_invite_email(&env, &email, &org_name).await;
+    }
+
+    Ok(Json(json!({
+        "object": "organizationUserBulkResponse",
+        "notFound": not_found,
+    })))
+}
+
+/// POST /api/organizations/{id}/users/{ouid}/accept — invited user accepts.
+#[worker::send]
+pub async fn accept_invite(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Path((org_id, ouid)): Path<(String, String)>,
+    Json(_payload): Json<AcceptInviteRequest>,
+) -> Result<Json<()>, AppError> {
+    let db = db::get_db(&env)?;
+    let now = db::now_string();
+    // Only the invited user themselves can accept their own invite.
+    let updated = d1_query!(
+        &db,
+        "UPDATE organization_users SET status = ?1, updated_at = ?2 \
+         WHERE id = ?3 AND organization_id = ?4 AND user_id = ?5 AND status = ?6",
+        STATUS_ACCEPTED,
+        now,
+        ouid,
+        org_id,
+        claims.sub,
+        STATUS_INVITED
+    )
+    .map_err(|_| AppError::Database)?
+    .run()
+    .await?;
+    let _ = updated;
+    Ok(Json(()))
+}
