+/// PUT /api/organizations/{id}/users/{ouid} — change a member's type + collections (Owner/Admin).
+#[worker::send]
+pub async fn update_org_user(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Path((org_id, ouid)): Path<(String, String)>,
+    Json(payload): Json<UpdateOrgUserRequest>,
+) -> Result<Json<()>, AppError> {
+    let db = db::get_db(&env)?;
+    require_org_manage(&db, &claims.sub, &org_id).await?;
+    let member = fetch_membership(&db, &org_id, &ouid).await?;
+    let now = db::now_string();
+
+    // Don't allow demoting the last owner.
+    if member.atype == TYPE_OWNER
+        && payload.atype != TYPE_OWNER
+        && confirmed_owner_count(&db, &org_id).await? <= 1
+    {
+        return Err(AppError::BadRequest(
+            "Cannot remove the last owner".to_string(),
+        ));
+    }
+
+    d1_query!(
+        &db,
+        "UPDATE organization_users SET atype = ?1, updated_at = ?2 WHERE id = ?3 AND organization_id = ?4",
+        payload.atype,
+        now,
+        ouid,
+        org_id
+    )
+    .map_err(|_| AppError::Database)?
+    .run()
+    .await?;
+
+    assign_member_collections(&db, &org_id, &ouid, &payload.collections).await?;
+    Ok(Json(()))
+}
