+/// PUT /api/organizations/{id} — rename / update billing email (Owner only).
+#[worker::send]
+pub async fn update_organization(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Path(org_id): Path<String>,
+    Json(payload): Json<UpdateOrganizationRequest>,
+) -> Result<Json<Value>, AppError> {
+    let db = db::get_db(&env)?;
+    let member = require_org_member(&db, &claims.sub, &org_id).await?;
+    if member.atype != TYPE_OWNER {
+        return Err(AppError::Unauthorized("Only owners can edit the organization".to_string()));
+    }
+    let now = db::now_string();
+
+    let mut org: Organization = d1_query!(&db, "SELECT * FROM organizations WHERE id = ?1", org_id)
+        .map_err(|_| AppError::Database)?
+        .first(None)
+        .await?
+        .ok_or_else(|| AppError::NotFound("Organization not found".to_string()))?;
+    org.name = payload.name;
+    if let Some(be) = payload.billing_email {
+        org.billing_email = be;
+    }
+
+    d1_query!(
+        &db,
+        "UPDATE organizations SET name = ?1, billing_email = ?2, updated_at = ?3 WHERE id = ?4",
+        org.name,
+        org.billing_email,
+        now,
+        org.id
+    )
+    .map_err(|_| AppError::Database)?
+    .run()
+    .await?;
+
+    Ok(Json(organization_response(&org, member.atype)))
+}
