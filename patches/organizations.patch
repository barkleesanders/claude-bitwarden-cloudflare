+/// POST /api/organizations/{id}/leave — caller removes their own membership.
+#[worker::send]
+pub async fn leave_organization(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Path(org_id): Path<String>,
+) -> Result<Json<()>, AppError> {
+    let db = db::get_db(&env)?;
+    let member = require_org_member(&db, &claims.sub, &org_id).await?;
+    if member.atype == TYPE_OWNER && confirmed_owner_count(&db, &org_id).await? <= 1 {
+        return Err(AppError::BadRequest(
+            "You are the only owner; transfer ownership before leaving".to_string(),
+        ));
+    }
+    d1_query!(
+        &db,
+        "DELETE FROM organization_users WHERE id = ?1",
+        member.id
+    )
+    .map_err(|_| AppError::Database)?
+    .run()
+    .await?;
+    Ok(Json(()))
+}
