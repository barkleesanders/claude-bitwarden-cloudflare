+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CipherCollectionsRequest {
+    #[serde(default)]
+    pub collection_ids: Vec<String>,
+}
+
+#[derive(Debug, Deserialize)]
+struct CollectionIdRow {
+    #[allow(dead_code)]
+    id: String,
+}
+
+/// Fetch a cipher row by id only (not scoped to a user). Used for org ciphers.
+/// Coalesces a NULL user_id to "" so org-owned ciphers deserialize into CipherDBModel.
+async fn fetch_cipher_by_id(db: &crate::db::Db, id: &str) -> Result<CipherDBModel, AppError> {
+    db.prepare(
+        "SELECT id, COALESCE(user_id, '') AS user_id, organization_id, type, data, favorite, \
+                folder_id, deleted_at, archived_at, created_at, updated_at \
+         FROM ciphers WHERE id = ?1",
+    )
+    .bind(&[id.to_string().into()])?
+    .first(None)
+    .await
+    .map_err(|_| AppError::Database)?
+    .ok_or_else(|| AppError::NotFound("Cipher not found".to_string()))
+}
+
+/// Is this user an Owner/Admin of the given org?
+async fn is_org_manager(db: &crate::db::Db, org_id: &str, user_id: &str) -> Result<bool, AppError> {
+    let row: Option<CollectionIdRow> = db
+        .prepare("SELECT id FROM organization_users WHERE organization_id = ?1 AND user_id = ?2 AND status = 2 AND atype <= 1")
+        .bind(&[org_id.to_string().into(), user_id.to_string().into()])?
+        .first(None)
+        .await
+        .map_err(|_| AppError::Database)?;
+    Ok(row.is_some())
+}
+
+/// Can the user READ this cipher (own it, or org admin, or assigned to a collection holding it)?
+async fn user_can_access_cipher(
+    db: &crate::db::Db,
+    cipher: &CipherDBModel,
+    user_id: &str,
+) -> Result<bool, AppError> {
+    if cipher.user_id == user_id {
+        return Ok(true);
+    }
+    let org_id = match cipher.organization_id.as_deref() {
+        Some(o) => o,
+        None => return Ok(false),
+    };
+    if is_org_manager(db, org_id, user_id).await? {
+        return Ok(true);
+    }
+    let row: Option<CollectionIdRow> = db
+        .prepare(
+            "SELECT cc.cipher_id AS id FROM collection_ciphers cc \
+             JOIN collection_users cu ON cu.collection_id = cc.collection_id \
+             JOIN organization_users ou ON ou.id = cu.organization_user_id \
+             WHERE cc.cipher_id = ?1 AND ou.user_id = ?2 AND ou.status = 2",
+        )
+        .bind(&[cipher.id.clone().into(), user_id.to_string().into()])?
+        .first(None)
+        .await
+        .map_err(|_| AppError::Database)?;
+    Ok(row.is_some())
+}
+
+/// Can the user EDIT this cipher (own it, or org admin, or `manage` on a holding collection)?
+async fn user_can_manage_cipher(
+    db: &crate::db::Db,
+    cipher: &CipherDBModel,
+    user_id: &str,
+) -> Result<bool, AppError> {
+    if cipher.user_id == user_id {
+        return Ok(true);
+    }
+    let org_id = match cipher.organization_id.as_deref() {
+        Some(o) => o,
+        None => return Ok(false),
+    };
+    if is_org_manager(db, org_id, user_id).await? {
+        return Ok(true);
+    }
+    let row: Option<CollectionIdRow> = db
+        .prepare(
+            "SELECT cc.cipher_id AS id FROM collection_ciphers cc \
+             JOIN collection_users cu ON cu.collection_id = cc.collection_id \
+             JOIN organization_users ou ON ou.id = cu.organization_user_id \
+             WHERE cc.cipher_id = ?1 AND ou.user_id = ?2 AND ou.status = 2 AND cu.manage = 1",
+        )
+        .bind(&[cipher.id.clone().into(), user_id.to_string().into()])?
+        .first(None)
+        .await
+        .map_err(|_| AppError::Database)?;
+    Ok(row.is_some())
+}
+
+/// Fetch a cipher the user may READ (personal or accessible org cipher).
+async fn fetch_cipher_for_read(
+    db: &crate::db::Db,
+    id: &str,
+    user_id: &str,
+) -> Result<CipherDBModel, AppError> {
+    let c = fetch_cipher_by_id(db, id).await?;
+    if user_can_access_cipher(db, &c, user_id).await? {
+        Ok(c)
+    } else {
+        Err(AppError::NotFound("Cipher not found".to_string()))
+    }
+}
+
+/// Fetch a cipher the user may EDIT (personal or manageable org cipher).
+async fn fetch_cipher_for_edit(
+    db: &crate::db::Db,
+    id: &str,
+    user_id: &str,
+) -> Result<CipherDBModel, AppError> {
+    let c = fetch_cipher_by_id(db, id).await?;
+    if user_can_manage_cipher(db, &c, user_id).await? {
+        Ok(c)
+    } else {
+        Err(AppError::NotFound("Cipher not found".to_string()))
+    }
+}
