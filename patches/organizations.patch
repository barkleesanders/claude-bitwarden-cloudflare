+/// Replace a member's per-collection access rows. Selections referencing a
+/// collection outside this org are silently ignored (cross-org guard).
+async fn assign_member_collections(
+    db: &Db,
+    org_id: &str,
+    org_user_id: &str,
+    selections: &[CollectionAccessSelection],
+) -> Result<(), AppError> {
+    d1_query!(
+        db,
+        "DELETE FROM collection_users WHERE organization_user_id = ?1",
+        org_user_id
+    )
+    .map_err(|_| AppError::Database)?
+    .run()
+    .await?;
+
+    for sel in selections {
+        let belongs: Option<IdRow> = d1_query!(
+            db,
+            "SELECT id FROM collections WHERE id = ?1 AND organization_id = ?2",
+            sel.id,
+            org_id
+        )
+        .map_err(|_| AppError::Database)?
+        .first(None)
+        .await?;
+        if belongs.is_none() {
+            continue;
+        }
+        d1_query!(
+            db,
+            "INSERT INTO collection_users (collection_id, organization_user_id, read_only, hide_passwords, manage) \
+             VALUES (?1, ?2, ?3, ?4, ?5)",
+            sel.id,
+            org_user_id,
+            sel.read_only,
+            sel.hide_passwords,
+            sel.manage
+        )
+        .map_err(|_| AppError::Database)?
+        .run()
+        .await?;
+    }
+    Ok(())
+}
