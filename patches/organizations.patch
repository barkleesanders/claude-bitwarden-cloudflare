+++ b/src/models/organization.rs
@@ -0,0 +1,399 @@
+use serde::Deserialize;
+use serde_json::{json, Value};
+
+// ---- Membership status / type constants (Bitwarden contract) ----
+#[allow(dead_code)]
+pub const STATUS_INVITED: i64 = 0;
+#[allow(dead_code)]
+pub const STATUS_ACCEPTED: i64 = 1;
+pub const STATUS_CONFIRMED: i64 = 2;
+
+pub const TYPE_OWNER: i64 = 0;
+#[allow(dead_code)]
+pub const TYPE_ADMIN: i64 = 1;
+#[allow(dead_code)]
+pub const TYPE_USER: i64 = 2;
+#[allow(dead_code)]
+pub const TYPE_MANAGER: i64 = 3;
+
+// ---- DB row structs (field names must match column names) ----
+
+#[derive(Debug, Deserialize)]
+pub struct Organization {
+    pub id: String,
+    pub name: String,
+    pub billing_email: String,
+    pub public_key: String,
+    pub private_key: String,
+    pub created_at: String,
+    pub updated_at: String,
+}
+
+// Several fields are persisted now but first read in Phase 2 (invites/ACL):
+// organization_id, email, created_at, updated_at.
+#[allow(dead_code)]
+#[derive(Debug, Deserialize)]
+pub struct OrganizationUser {
+    pub id: String,
+    pub organization_id: String,
+    pub user_id: Option<String>,
+    pub email: String,
+    pub akey: Option<String>,
+    pub status: i64,
+    pub atype: i64,
+    pub created_at: String,
+    pub updated_at: String,
+}
+
+#[derive(Debug, Deserialize)]
+pub struct Collection {
+    pub id: String,
+    pub organization_id: String,
+    pub name: String,
+    pub external_id: Option<String>,
+    pub created_at: String,
+    pub updated_at: String,
+}
+
+// ---- Request DTOs (camelCase from official clients) ----
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct OrgKeysData {
+    pub public_key: String,
+    pub encrypted_private_key: String,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CreateOrganizationRequest {
+    pub name: String,
+    #[serde(default)]
+    pub billing_email: String,
+    /// The org symmetric key wrapped with the creating user's RSA public key.
+    pub key: String,
+    /// The org RSA keypair (private key already encrypted with the org symmetric key).
+    pub keys: Option<OrgKeysData>,
+    /// Default collection name, encrypted with the org symmetric key.
+    #[serde(default)]
+    pub collection_name: Option<String>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CreateCollectionRequest {
+    pub name: String,
+    #[serde(default)]
+    pub external_id: Option<String>,
+    /// Members assigned to this collection (web vault sends these on create/update).
+    #[serde(default)]
+    pub users: Vec<CollectionAccessSelection>,
+}
+
+/// One collection's access flags for a member (used in invite + collection assignment).
+#[derive(Debug, Clone, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CollectionAccessSelection {
+    pub id: String,
+    #[serde(default)]
+    pub read_only: bool,
+    #[serde(default)]
+    pub hide_passwords: bool,
+    #[serde(default)]
+    pub manage: bool,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct InviteUsersRequest {
+    pub emails: Vec<String>,
+    #[serde(rename = "type")]
+    pub atype: i64,
+    #[serde(default)]
+    pub collections: Vec<CollectionAccessSelection>,
+    // access_all = "member can see every collection without explicit assignment".
+    // Phase 3 (needs a membership column); owners/admins already see all via atype.
+    #[allow(dead_code)]
+    #[serde(default)]
+    pub access_all: bool,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ConfirmUserRequest {
+    /// The org symmetric key wrapped with the confirmed member's RSA public key.
+    pub key: String,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AcceptInviteRequest {
+    // Email-link accept token; unused in manual-confirm mode (invites appear in the
+    // invited user's own sync, so no out-of-band token is required).
+    #[allow(dead_code)]
+    #[serde(default)]
+    pub token: Option<String>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct UpdateOrgUserRequest {
+    #[serde(rename = "type")]
+    pub atype: i64,
+    #[serde(default)]
+    pub collections: Vec<CollectionAccessSelection>,
+    // access_all = "member can see every collection without explicit assignment".
+    // Phase 3 (needs a membership column); owners/admins already see all via atype.
+    #[allow(dead_code)]
+    #[serde(default)]
+    pub access_all: bool,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct UpdateOrganizationRequest {
+    pub name: String,
+    #[serde(default)]
+    pub billing_email: Option<String>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PutCollectionUsersRequest {
+    #[serde(default)]
+    pub users: Vec<CollectionAccessSelection>,
+}
+
+// ---- Groups ----
+
+#[derive(Debug, Deserialize)]
+pub struct Group {
+    pub id: String,
+    pub organization_id: String,
+    pub name: String,
+    pub external_id: Option<String>,
+    #[allow(dead_code)]
+    pub created_at: String,
+    pub updated_at: String,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CreateGroupRequest {
+    pub name: String,
+    #[serde(default)]
+    pub external_id: Option<String>,
+    #[serde(default)]
+    pub collections: Vec<CollectionAccessSelection>,
+    /// org_user ids that belong to this group.
+    #[serde(default)]
+    pub users: Vec<String>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PutGroupUsersRequest {
+    #[serde(default)]
+    pub group_users: Vec<String>,
+}
+
+pub fn group_response(g: &Group) -> Value {
+    json!({
+        "id": g.id,
+        "organizationId": g.organization_id,
+        "name": g.name,
+        "externalId": g.external_id,
+        "object": "group",
+    })
+}
+
+// ---- Policies ----
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PutPolicyRequest {
+    pub enabled: bool,
+    #[serde(default)]
+    pub data: Option<Value>,
+}
+
+pub fn policy_response(organization_id: &str, ptype: i64, enabled: bool, data: &Option<String>) -> Value {
+    let data_val: Value = data
+        .as_deref()
+        .and_then(|s| serde_json::from_str(s).ok())
+        .unwrap_or(Value::Null);
+    json!({
+        "id": format!("{organization_id}-{ptype}"),
+        "organizationId": organization_id,
+        "type": ptype,
+        "enabled": enabled,
+        "data": data_val,
+        "object": "policy",
+    })
+}
+
+// ---- Response builders (Bitwarden-compatible JSON) ----
+
+/// `OrganizationResponseModel` returned from create/get organization.
+pub fn organization_response(org: &Organization, member_type: i64) -> Value {
+    json!({
+        "id": org.id,
+        "name": org.name,
+        "billingEmail": org.billing_email,
+        "businessName": Value::Null,
+        "key": Value::Null,
+        "object": "organization",
+        "enabled": true,
+        "type": member_type,
+        "status": STATUS_CONFIRMED,
+        "useGroups": false,
+        "useDirectory": false,
+        "useEvents": false,
+        "useTotp": true,
+        "use2fa": true,
+        "usersGetPremium": true,
+        "useApi": true,
+        "usePolicies": false,
+        "useSso": false,
+        "useResetPassword": false,
+        "selfHost": true,
+        "hasPublicAndPrivateKeys": true,
+        "seats": Value::Null,
+        "maxCollections": Value::Null,
+        "maxStorageGb": Value::Null,
+        "identifier": Value::Null,
+    })
+}
+
+/// `profileOrganization` entry embedded in GET /api/sync `profile.organizations`.
+pub fn profile_organization(org_id: &str, name: &str, member: &OrganizationUser) -> Value {
+    let is_owner = member.atype == TYPE_OWNER;
+    let is_admin = member.atype <= TYPE_ADMIN;
+    json!({
+        "id": org_id,
+        "name": name,
+        "key": member.akey,
+        "status": member.status,
+        "type": member.atype,
+        "enabled": true,
+        "object": "profileOrganization",
+        "userId": member.user_id,
+        "useGroups": false,
+        "useDirectory": false,
+        "useEvents": false,
+        "useTotp": true,
+        "use2fa": true,
+        "useApi": true,
+        "usePolicies": false,
+        "useSso": false,
+        "useKeyConnector": false,
+        "useScim": false,
+        "useResetPassword": false,
+        "usersGetPremium": true,
+        "selfHost": true,
+        "hasPublicAndPrivateKeys": true,
+        "resetPasswordEnrolled": false,
+        "seats": Value::Null,
+        "maxCollections": Value::Null,
+        "maxStorageGb": Value::Null,
+        "ssoBound": false,
+        "identifier": Value::Null,
+        "permissions": {
+            "accessEventLogs": is_admin,
+            "accessImportExport": is_admin,
+            "accessReports": is_admin,
+            "createNewCollections": is_admin,
+            "editAnyCollection": is_admin,
+            "deleteAnyCollection": is_admin,
+            "manageGroups": is_admin,
+            "managePolicies": is_owner,
+            "manageSso": is_owner,
+            "manageUsers": is_admin,
+            "manageResetPassword": is_owner,
+            "manageScim": is_owner
+        },
+        "providerId": Value::Null,
+        "providerName": Value::Null,
+        "familySponsorshipFriendlyName": Value::Null,
+        "keyConnectorEnabled": false,
+        "keyConnectorUrl": Value::Null,
+    })
+}
+
+/// `collection` object (GET /api/organizations/{id}/collections).
+pub fn collection_response(col: &Collection) -> Value {
+    json!({
+        "id": col.id,
+        "organizationId": col.organization_id,
+        "name": col.name,
+        "externalId": col.external_id,
+        "object": "collection",
+    })
+}
+
+/// One `{id, readOnly, hidePasswords, manage}` collection-access entry.
+pub fn collection_membership(
+    collection_id: &str,
+    read_only: bool,
+    hide_passwords: bool,
+    manage: bool,
+) -> Value {
+    json!({
+        "id": collection_id,
+        "readOnly": read_only,
+        "hidePasswords": hide_passwords,
+        "manage": manage,
+    })
+}
+
+/// `organizationUserUserDetails` — a member row in GET /api/organizations/{id}/users.
+#[allow(clippy::too_many_arguments)]
+pub fn org_user_details(
+    id: &str,
+    user_id: &Option<String>,
+    name: &Option<String>,
+    email: &str,
+    atype: i64,
+    status: i64,
+    collections: Vec<Value>,
+) -> Value {
+    json!({
+        "id": id,
+        "userId": user_id,
+        "name": name,
+        "email": email,
+        "type": atype,
+        "status": status,
+        "accessAll": false,
+        "twoFactorEnabled": false,
+        "resetPasswordEnrolled": false,
+        "ssoBound": false,
+        "hasMasterPassword": true,
+        "collections": collections,
+        "groups": [],
+        "object": "organizationUserUserDetails",
+    })
+}
+
+/// `collectionDetails` object embedded in GET /api/sync `collections`.
+/// `manage`/`read_only`/`hide_passwords` reflect this user's access to the collection.
+pub fn collection_details(
+    id: &str,
+    organization_id: &str,
+    name: &str,
+    external_id: &Option<String>,
+    read_only: bool,
+    hide_passwords: bool,
+    manage: bool,
+) -> Value {
+    json!({
+        "id": id,
+        "organizationId": organization_id,
+        "name": name,
+        "externalId": external_id,
+        "readOnly": read_only,
+        "hidePasswords": hide_passwords,
+        "manage": manage,
+        "object": "collectionDetails",
+    })
+}
