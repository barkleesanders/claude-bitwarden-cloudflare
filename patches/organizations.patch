+// ============================================================================
+// Per-collection member assignment
+// ============================================================================
+
+/// GET /api/organizations/{id}/collections/{cid}/users — members assigned to a collection.
+#[worker::send]
+pub async fn get_collection_users(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Path((org_id, collection_id)): Path<(String, String)>,
+) -> Result<Json<Value>, AppError> {
+    let db = db::get_db(&env)?;
+    require_org_member(&db, &claims.sub, &org_id).await?;
+
+    #[derive(Debug, Deserialize)]
+    struct Row {
+        organization_user_id: String,
+        read_only: i64,
+        hide_passwords: i64,
+        manage: i64,
+    }
+    let rows: Vec<Row> = d1_query!(
+        &db,
+        "SELECT cu.organization_user_id AS organization_user_id, cu.read_only AS read_only, \
+                cu.hide_passwords AS hide_passwords, cu.manage AS manage \
+         FROM collection_users cu \
+         JOIN collections c ON c.id = cu.collection_id \
+         WHERE cu.collection_id = ?1 AND c.organization_id = ?2",
+        collection_id,
+        org_id
+    )
+    .map_err(|_| AppError::Database)?
+    .all()
+    .await?
+    .results()
+    .map_err(|_| AppError::Database)?;
+
+    let items: Vec<Value> = rows
+        .into_iter()
+        .map(|r| {
+            collection_membership(&r.organization_user_id, r.read_only != 0, r.hide_passwords != 0, r.manage != 0)
+        })
+        .collect();
+    Ok(Json(json!(items)))
+}
+
+/// PUT /api/organizations/{id}/collections/{cid}/users — set the collection's members (Owner/Admin).
+#[worker::send]
+pub async fn put_collection_users(
+    claims: Claims,
+    State(env): State<Arc<Env>>,
+    Path((org_id, collection_id)): Path<(String, String)>,
+    Json(payload): Json<PutCollectionUsersRequest>,
+) -> Result<Json<()>, AppError> {
+    let db = db::get_db(&env)?;
+    require_org_manage(&db, &claims.sub, &org_id).await?;
+
+    // Verify the collection belongs to the org.
+    let belongs: Option<IdRow> = d1_query!(
+        &db,
+        "SELECT id FROM collections WHERE id = ?1 AND organization_id = ?2",
+        collection_id,
+        org_id
+    )
+    .map_err(|_| AppError::Database)?
+    .first(None)
+    .await?;
+    belongs.ok_or_else(|| AppError::NotFound("Collection not found".to_string()))?;
+
+    d1_query!(
+        &db,
+        "DELETE FROM collection_users WHERE collection_id = ?1",
+        collection_id
+    )
+    .map_err(|_| AppError::Database)?
+    .run()
+    .await?;
+
+    for sel in &payload.users {
+        // sel.id here is an organization_user_id; verify it is in this org.
+        let in_org: Option<IdRow> = d1_query!(
+            &db,
+            "SELECT id FROM organization_users WHERE id = ?1 AND organization_id = ?2",
+            sel.id,
+            org_id
+        )
+        .map_err(|_| AppError::Database)?
+        .first(None)
+        .await?;
+        if in_org.is_none() {
+            continue;
+        }
+        d1_query!(
+            &db,
+            "INSERT INTO collection_users (collection_id, organization_user_id, read_only, hide_passwords, manage) \
+             VALUES (?1, ?2, ?3, ?4, ?5)",
+            collection_id,
+            sel.id,
+            sel.read_only,
+            sel.hide_passwords,
+            sel.manage
+        )
+        .map_err(|_| AppError::Database)?
+        .run()
+        .await?;
+    }
+    Ok(Json(()))
+}
