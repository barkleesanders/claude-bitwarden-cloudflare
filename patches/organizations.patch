+    org_user_ids: &[String],
+) -> Result<(), AppError> {
+    d1_query!(db, "DELETE FROM group_users WHERE group_id = ?1", group_id)
+        .map_err(|_| AppError::Database)?
+        .run()
+        .await?;
+    for ouid in org_user_ids {
+        let in_org: Option<IdRow> = d1_query!(
+            db,
+            "SELECT id FROM organization_users WHERE id = ?1 AND organization_id = ?2",
+            ouid,
+            org_id
+        )
+        .map_err(|_| AppError::Database)?
+        .first(None)
+        .await?;
+        if in_org.is_none() {
+            continue;
+        }
+        d1_query!(
+            db,
+            "INSERT OR IGNORE INTO group_users (group_id, organization_user_id) VALUES (?1, ?2)",
+            group_id,
+            ouid
+        )
+        .map_err(|_| AppError::Database)?
+        .run()
+        .await?;
+    }
+    Ok(())
+}
