--- a/src/handlers/identity.rs
+++ b/src/handlers/identity.rs
@@ -89,6 +89,11 @@ pub struct TokenRequest {
     device_name: Option<String>,
     #[serde(rename = "device_type", alias = "deviceType", alias = "devicetype")]
     device_type: Option<String>,
+    // SSO authorization-code grant (issued by /sso/callback).
+    #[serde(default)]
+    code: Option<String>,
+    #[serde(rename = "code_verifier", alias = "codeVerifier", default)]
+    code_verifier: Option<String>,
 }
 
 #[derive(Debug)]
@@ -785,6 +790,62 @@ pub async fn token(
 
             generate_tokens_and_response(user, &device, &device_request.client_id, &env, None)
         }
+        "authorization_code" => {
+            // SSO login: redeem the one-time code minted by /sso/callback after the IdP's
+            // id_token was signature-verified. Optional PKCE (S256) per the web vault.
+            let code = required_field(payload.code.as_deref(), "code")?;
+
+            #[derive(serde::Deserialize)]
+            struct AuthCodeRow {
+                user_id: String,
+                code_challenge: Option<String>,
+            }
+            let row: Option<AuthCodeRow> = db
+                .prepare("SELECT user_id, code_challenge FROM sso_auth_codes WHERE code = ?1")
+                .bind(&[code.clone().into()])?
+                .first(None)
+                .await
+                .map_err(|_| AppError::Database)?;
+            let row = row.ok_or_else(|| AppError::BadRequest("invalid_grant".to_string()))?;
+            // One-time use.
+            let _ = db
+                .prepare("DELETE FROM sso_auth_codes WHERE code = ?1")
+                .bind(&[code.clone().into()])?
+                .run()
+                .await;
+
+            if let Some(challenge) = row.code_challenge {
+                let verifier = required_field(payload.code_verifier.as_deref(), "code_verifier")?;
+                if !crate::crypto::ct_eq(&crate::crypto::pkce_s256(&verifier), &challenge) {
+                    return Err(AppError::BadRequest("invalid_grant".to_string()));
+                }
+            }
+
+            let user = load_user_by_id(&db, &row.user_id)
+                .await
+                .map_err(|_| AppError::Unauthorized("invalid_grant".to_string()))?;
+
+            let device_request = DeviceAuthRequest {
+                client_id: payload.client_id.clone().unwrap_or_else(|| "web".to_string()),
+                identifier: required_field(
+                    payload.device_identifier.as_deref(),
+                    "device_identifier",
+                )?,
+                name: required_field(payload.device_name.as_deref(), "device_name")?,
+                r#type: parse_required_device_type(payload.device_type.as_deref(), "device_type")?,
+            };
+            let mut device = Device::get_or_create(
+                &db,
+                device_request.identifier,
+                user.id.clone(),
+                device_request.name,
+                device_request.r#type,
+            )
+            .await?;
+            device.touch(&db).await?;
+
+            generate_tokens_and_response(user, &device, &device_request.client_id, &env, None)
+        }
         _ => Err(AppError::BadRequest("Unsupported grant_type".to_string())),
     }
 }
