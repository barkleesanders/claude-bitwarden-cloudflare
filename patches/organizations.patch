--- /dev/null
+++ b/src/handlers/email.rs
@@ -0,0 +1,56 @@
+use worker::{Env, Fetch, Headers, Method, Request, RequestInit};
+
+/// Best-effort outbound invite email.
+///
+/// Cloudflare's free tier can't reliably send arbitrary outbound mail, so invites
+/// work fully without email (manual-confirm). If you want a notification, point these
+/// at any Resend-compatible JSON endpoint:
+///   EMAIL_PROVIDER_URL  e.g. https://api.resend.com/emails
+///   EMAIL_API_KEY       bearer token (set as a Worker secret)
+///   EMAIL_FROM          verified sender address
+/// If any are missing this is a no-op — the invite still succeeds.
+pub async fn send_invite_email(env: &Env, to: &str, org_name: &str) {
+    let url = match env.var("EMAIL_PROVIDER_URL") {
+        Ok(v) => v.to_string(),
+        Err(_) => return,
+    };
+    let api_key = match env
+        .secret("EMAIL_API_KEY")
+        .map(|s| s.to_string())
+        .or_else(|_| env.var("EMAIL_API_KEY").map(|v| v.to_string()))
+    {
+        Ok(v) => v,
+        Err(_) => return,
+    };
+    let from = env
+        .var("EMAIL_FROM")
+        .map(|v| v.to_string())
+        .unwrap_or_else(|_| "no-reply@localhost".to_string());
+
+    let subject = format!("You've been invited to {org_name}");
+    let html = format!(
+        "<p>You've been invited to the <strong>{org_name}</strong> organization.</p>\
+         <p>Open your Bitwarden app, sign in, and accept the invitation. \
+         An administrator will then confirm your access.</p>"
+    );
+    let body = serde_json::json!({
+        "from": from,
+        "to": [to],
+        "subject": subject,
+        "html": html,
+    })
+    .to_string();
+
+    let headers = Headers::new();
+    let _ = headers.set("Authorization", &format!("Bearer {api_key}"));
+    let _ = headers.set("Content-Type", "application/json");
+
+    let mut init = RequestInit::new();
+    init.with_method(Method::Post)
+        .with_headers(headers)
+        .with_body(Some(body.into()));
+
+    if let Ok(req) = Request::new_with_init(&url, &init) {
+        let _ = Fetch::Request(req).send().await;
+    }
+}
