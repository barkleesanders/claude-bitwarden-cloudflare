+    crypto
+        .get_random_values_with_array_buffer_view(&bytes)
+        .map_err(|e| AppError::Crypto(format!("Failed to generate api key: {:?}", e)))?;
+
+    Ok(base32_encode(&bytes.to_vec()))
+}
